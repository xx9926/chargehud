<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 主题背景单独一层：模糊用 RenderEffect 只作用在它身上，文字不受影响。 -->
    <View
        android:id="@+id/bgLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 背景视频那一层，垫在 bgLayer 的纯色底上面；居中是为了代码把它撑成裁剪尺寸后仍然对齐屏幕。 -->
    <TextureView
        android:id="@+id/bgVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/pageScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:text="充电悬浮窗"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/liveReading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="显示悬浮窗"
                android:textSize="17sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/appearanceHeader"
            style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/section_appearance" />

        <LinearLayout
            android:id="@+id/appearanceSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/RowLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="悬浮窗显示内容" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/checkShowPower"
                    style="@style/ShowFieldCheck"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="功率" />

                <CheckBox
                    android:id="@+id/checkShowTemp"
                    style="@style/ShowFieldCheck"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="温度" />

                <CheckBox
                    android:id="@+id/checkShowVolt"
                    style="@style/ShowFieldCheck"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="电压" />

                <CheckBox
                    android:id="@+id/checkShowAmp"
                    style="@style/ShowFieldCheck"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="电流" />
            </LinearLayout>

            <TextView
                style="@style/RowLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="勾选的先后顺序就是悬浮窗从上到下的排列顺序"
                android:textSize="13sp" />

            <TextView
                style="@style/RowLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="文字大小" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/seekTextSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/textSizeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="56dp"
                    android:gravity="end" />
            </LinearLayout>

            <TextView
                style="@style/RowLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="悬浮窗透明度" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/seekBackgroundAlpha"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/backgroundAlphaValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="56dp"
                    android:gravity="end" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="文字颜色"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnPalette"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="调色盘"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/posHeader"
            style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/section_position" />

        <LinearLayout
            android:id="@+id/posSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 用 TextView 而不是 Button：Material 主题会把 Button 换成 MaterialButton
                     并刷上 colorPrimary，灰色描边会被染成橙色。 -->
                <TextView
                    android:id="@+id/btnUp"
                    style="@style/PosButton"
                    android:text="▲" />

                <TextView
                    android:id="@+id/btnDown"
                    style="@style/PosButton"
                    android:text="▼" />

                <TextView
                    android:id="@+id/btnLeft"
                    style="@style/PosButton"
                    android:text="◀" />

                <TextView
                    android:id="@+id/btnRight"
                    style="@style/PosButton"
                    android:text="▶" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="锁定悬浮窗"
                    android:textSize="15sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchLocked"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                style="@style/RowLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lock_hint"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/archiveHeader"
            style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/section_archive" />

        <TextView
            android:id="@+id/dataHeader"
            style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/section_data" />

        <LinearLayout
            android:id="@+id/dataSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/themeHeader"
                style="@style/SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="10dp"
                android:text="@string/section_theme"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/themeSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="27dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="背景图/视频"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/bgPhotoValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="end"
                        android:maxWidth="200dp"
                        android:ellipsize="start"
                        android:singleLine="true"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/bgPhotoClear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:minWidth="44dp"
                        android:gravity="end"
                        android:text="清除"
                        android:textSize="15sp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="27dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="背景颜色"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/bgColorValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:minWidth="76dp"
                        android:gravity="end"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    style="@style/RowLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="背景透明度" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <SeekBar
                        android:id="@+id/seekBgAlpha"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/bgAlphaValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="56dp"
                        android:gravity="end" />
                </LinearLayout>

                <TextView
                    style="@style/RowLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="背景模糊" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <SeekBar
                        android:id="@+id/seekBgBlur"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/bgBlurValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="56dp"
                        android:gravity="end" />
                </LinearLayout>

                <TextView
                    style="@style/RowHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="背景只影响设置页和档案页；照片或视频太花就把模糊调高、透明度调低，保证文字看得清。视频请选 60MB 以内的短视频。" />
            </LinearLayout>

            <TextView
                android:id="@+id/alertHeader"
                style="@style/SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="10dp"
                android:text="@string/section_alerts"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/alertSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="27dp"
                    android:orientation="horizontal">
    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="高温提醒"
                        android:textSize="15sp" />
    
                    <TextView
                        android:id="@+id/alertTempValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:minWidth="76dp"
                        android:gravity="end"
                        android:textSize="15sp" />
                </LinearLayout>
    
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="27dp"
                    android:orientation="horizontal">
    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="慢充提醒"
                        android:textSize="15sp" />
    
                    <TextView
                        android:id="@+id/alertSlowValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:minWidth="76dp"
                        android:gravity="end"
                        android:textSize="15sp" />
                </LinearLayout>
    
                <TextView
                    style="@style/RowHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="电量 80% 以后功率本来就会降下来，那种情况不算充不进电，慢充提醒不会响。" />
    
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="27dp"
                    android:orientation="horizontal">
    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="涓流提醒"
                        android:textSize="15sp" />
    
                    <TextView
                        android:id="@+id/alertTrickleValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:minWidth="76dp"
                        android:gravity="end"
                        android:textSize="15sp" />
                </LinearLayout>
    
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="27dp"
                    android:orientation="horizontal">
    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="充满提醒"
                        android:textSize="15sp" />
    
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAlertFull"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
    
                <TextView
                    style="@style/RowHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="提醒走独立通知渠道；只要开着任意一条，插电期间就会自动判定，不用开悬浮窗（这条判定要靠后台服务活着，所以通知栏会留一条静默通知）。" />
            </LinearLayout>

            <TextView
                android:id="@+id/advancedHeader"
                style="@style/SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="10dp"
                android:text="@string/section_advanced"
                android:textSize="15sp" />
    
            <LinearLayout
                android:id="@+id/advancedSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
    
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="备选：读取 sysfs 电流节点"
                        android:textSize="15sp" />
    
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchSysFs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
    
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="双电芯修正（功率 ×2）"
                        android:textSize="15sp" />
    
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchDualCell"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
    
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="串联电压修正（电压 ÷2）"
                        android:textSize="15sp" />
    
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchHalfVoltage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
    
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="常驻任务栏（前台通知）"
                        android:textSize="15sp" />
    
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchResidentNotification"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
    
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="27dp"
                    android:orientation="horizontal">
    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="隐藏后台"
                        android:textSize="15sp" />
    
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchHideRecents"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
    
                <TextView
                    style="@style/RowHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="打开后设置页不进最近任务，清后台时没有可滑掉的目标，只剩悬浮窗服务；切换从下次进入设置页开始生效。" />
    
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="27dp"
                    android:orientation="horizontal">
    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="充电时后台记录"
                        android:textSize="15sp" />
    
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchRecordCharging"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
    
                <TextView
                    style="@style/RowHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="打开后插电就开始记档案，不用开着悬浮窗。通知栏那条静默通知是它和四条提醒共用的：只留提醒时也会一直在，撤掉它提醒就不触发了。" />
    
                <!-- 电池容量：自动 / 手动放在一起，开关和结果显示必须在同一块里才看得懂关联。 -->
                <TextView
                    style="@style/RowLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="电池容量" />
    
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="27dp"
                    android:orientation="horizontal">
    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="自动识别设计容量"
                        android:textSize="15sp" />
    
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAutoCapacity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
    
                <TextView
                    android:id="@+id/capacityAutoLabel"
                    style="@style/RowLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp" />
    
                <LinearLayout
                    android:id="@+id/capacityManualRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="27dp"
                    android:orientation="horizontal"
                    android:visibility="gone">
    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="手填容量（mAh）"
                        android:textSize="15sp" />
    
                    <EditText
                        android:id="@+id/capacityInput"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ems="4"
                        android:gravity="end"
                        android:hint="1000 ~ 20000"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="5"
                        android:textSize="15sp" />
                </LinearLayout>
    
                <TextView
                    style="@style/RowLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="刷新间隔" />
    
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
    
                    <SeekBar
                        android:id="@+id/seekRefresh"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
    
                    <TextView
                        android:id="@+id/refreshValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="56dp"
                        android:gravity="end" />
                </LinearLayout>
    
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:text="@string/tip_miui"
                    android:textSize="13sp" />
    
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:text="安卓未向第三方开放瓦特数接口，取数分四级：①系统电流属性 CURRENT_NOW ②sysfs 电流节点（多数小米机型禁读）③库仑计 charge counter 差分 ④电池容量×电量变化率。只有前两档不带 ≈ 标记。息屏状态下系统可能暂停刷新，亮屏后自动恢复。"
                    android:textSize="13sp" />
    
                <TextView
                    android:id="@+id/repoLink"
                    style="@style/RowLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</FrameLayout>
