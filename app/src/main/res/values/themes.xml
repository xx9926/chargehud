<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ChargeHud" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <!-- 全局换掉开关配色：开=天蓝、关=浅灰，界面上所有 SwitchCompat 一起生效。 -->
        <item name="switchStyle">@style/ChargeHudSwitch</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="ChargeHudSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
    </style>

    <style name="ShowFieldCheck" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="buttonTint">@color/switch_thumb</item>
    </style>

    <style name="SectionLabel">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/section_label</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="RowLabel">
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">10dp</item>
    </style>
</resources>
