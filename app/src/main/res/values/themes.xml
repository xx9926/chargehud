<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ChargeHud" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <!-- 全局换掉开关配色：开=天蓝、关=浅灰，界面上所有 SwitchCompat 一起生效。 -->
        <item name="switchStyle">@style/ChargeHudSwitch</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 档案页要跟手往右拖出去，窗口必须半透明：否则拖开的缝隙里只剩纯色底板，看不到下面的设置页。 -->
    <style name="Theme.ChargeHud.Archive" parent="Theme.ChargeHud">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="ChargeHudSwitch" parent="Widget.AppCompat.CompoundButton.Switch">        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
    </style>

    <style name="ShowFieldCheck" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="buttonTint">@color/switch_thumb</item>
    </style>

    <style name="SectionLabel">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/section_label</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="RowLabel">
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">10dp</item>
    </style>

    <!-- 紧跟在功能行下方的说明：留白要小，否则看不出是同一件事的说明。 -->
    <style name="RowHint" parent="RowLabel">
        <item name="android:paddingTop">2dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 四向位置按钮：描边把可点区域框出来，否则看着只是一排字符，不知道能点哪里。 -->
    <style name="PosButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/pos_button_frame</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/section_label</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
